{
  "name": "eleezgit",
  "version": "1.0.1",
  "type": "module",
  "description": "Fast, Lightweight, Native-style Git Diff Viewer & AI Commit Assistant built with Electron",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "electron dist-electron/main.cjs",
    "dev": "node scripts/dev.mjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "git",
    "diff",
    "ai",
    "commit",
    "electron",
    "developer-tools"
  ],
  "author": "EzGit Team <dev@ezgit.com>",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-spawn": "^7.0.6",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.ezgit.eleezgit",
    "productName": "EleEzGit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "assets/AppIcon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/AppIcon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/AppIcon.png",
      "category": "Development",
      "maintainer": "EzGit Team <dev@ezgit.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
